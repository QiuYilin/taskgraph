{
    "name": "taskgraph",
    "version-string": "latest",
    "dependencies": [
        {
            "name": "taskflow",
            "version>=": "3.11.0"
        },
        "spdlog"
    ],
    "features": {
        "ui": {
            "description": "Build Ui part",
            "dependencies": [                 
                {
                "name": "imgui",
                "version>=": "1.90.7",
                "features": [
                  "glfw-binding",
                  "opengl3-binding",
                  "docking-experimental"
                ]
            },
            "opengl",
                {
                    "name": "imgui-node-editor",
                    "version>=": "0.9.3"
                }
            ]
          },
        "examples":{
            "description": "Build examples",
            "dependencies": [
                "opencv4",
                "pcl"
            ]
        }
    },
    "builtin-baseline": "817892b0ecbc6af994dd6df999c73faf795adbf2"
}